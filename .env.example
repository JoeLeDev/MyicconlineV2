# URL publique du WordPress (API REST)
NEXT_PUBLIC_WP_URL=https://myicconline.com

# Lien de connexion communauté (reste sur WordPress / BuddyPress)
NEXT_PUBLIC_WP_LOGIN_URL=https://myicconline.com/

# Auth — secret HMAC pour cookie de session signé (min. 32 caractères)
# Générer : openssl rand -base64 48
# Obligatoire aussi sur Vercel (Project → Settings → Environment Variables)
AUTH_SECRET=

# Contact (Resend) — optionnel : sans clé, le formulaire ouvre mailto
RESEND_API_KEY=
CONTACT_TO_EMAIL=netezoua@yahoo.fr
CONTACT_FROM_EMAIL=ICC Online <onboarding@resend.dev>
